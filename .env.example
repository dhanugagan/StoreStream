# StoreStream Environment Configuration
# Copy to .env for local overrides. Never commit real credentials.

PORT=3000
FRONTEND_URL="http://localhost:3000"
APP_URL="MY_APP_URL"

# Local fallback SQLite database path when Aiven PostgreSQL is not configured
STORE_DATABASE_PATH="./data/storestream.db"

# JWT signing secret (auto-generates ephemeral random secret in memory if unset)
JWT_SECRET=""

# Optional server-side Admin passcode override (if unset, use the first-run Admin claim flow in the UI)
ADMIN_PASSCODE=""

# ==============================================================================
# AIVEN MANAGED INFRASTRUCTURE CREDENTIALS (Leave empty for local DEMO MODE)
# ==============================================================================

# 1. Aiven for PostgreSQL (Primary Source of Truth)
DATABASE_URL=""

# 2. Aiven for Apache Kafka (Event Backbone: order.placed, inventory.changed, order.confirmed, order.cancelled, product.updated)
KAFKA_BROKERS=""
KAFKA_USERNAME=""
KAFKA_PASSWORD=""
KAFKA_SSL="true"
KAFKA_SSL_CA=""

# 3. Aiven for OpenSearch (Typo-Tolerant Product Discovery & Faceted Search)
OPENSEARCH_NODE=""
OPENSEARCH_USERNAME=""
OPENSEARCH_PASSWORD=""
